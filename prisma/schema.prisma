generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Multi-tenancy — every domain row belongs to exactly one tenant.
// ===========================================================================

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users               User[]
  roles               Role[]
  stores              Store[]
  manufacturers       VehicleManufacturer[]
  models              VehicleModel[]
  variants            VehicleVariant[]
  colours             VehicleColour[]
  wheelBrands         WheelBrand[]
  wheelModels         WheelModel[]
  wheelFinishes       WheelFinish[]
  wheelSizes          WheelSize[]
  tyreBrands          TyreBrand[]
  tyreModels          TyreModel[]
  tyreProfiles        TyreProfile[]
  savedConfigurations SavedConfiguration[]
  customers           Customer[]
  quotes              Quote[]
  assets              Asset[]
  auditLogs           AuditLog[]
  quoteSequence       Int                 @default(0)
  priceLists          PriceList[]
  wheelPrices         WheelPrice[]
  tyrePrices          TyrePrice[]
  labourPrices        LabourPrice[]
  priceRules          PriceRule[]
  discountRules       DiscountRule[]
  quoteSnapshots      QuoteSnapshot[]
  quoteStatusHistories QuoteStatusHistory[]
  sessions            Session[]
  settings            TenantSettings?
  packages            VehiclePackage[]

  @@index([slug])
}

// ===========================================================================
// Identity & RBAC
// ===========================================================================

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  email               String    @unique
  name                String
  phone               String?
  avatarUrl           String?
  active              Boolean   @default(true)
  isDefault           Boolean   @default(false)
  passwordHash        String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  emailVerified       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles             UserRole[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([tenantId])
  @@index([email])
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@index([tenantId, name])
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ===========================================================================
// Authentication sessions & tokens (Sprint 12)
// ===========================================================================

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String    @db.Uuid
  token     String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// Stores
// ===========================================================================

model Store {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
}

// ===========================================================================
// Vehicle catalog
// ===========================================================================

model VehicleManufacturer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models VehicleModel[]

  @@unique([tenantId, name])
}

model VehicleModel {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  vehicleManufacturerId String    @db.Uuid
  name                  String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manufacturer        VehicleManufacturer  @relation(fields: [vehicleManufacturerId], references: [id], onDelete: Cascade)
  variants            VehicleVariant[]
  savedConfigurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([vehicleManufacturerId])
  @@unique([tenantId, vehicleManufacturerId, name])
}

model VehicleVariant {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  vehicleModelId  String    @db.Uuid
  name            String
  year            Int?
  wheelDiameterMm Int
  renderMetadata  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model          VehicleModel         @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  colours        VehicleColour[]
  configurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([vehicleModelId])
  @@unique([tenantId, vehicleModelId, name])
}

model VehicleColour {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  vehicleVariantId String    @db.Uuid
  name             String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
  @@index([vehicleVariantId])
  @@unique([tenantId, vehicleVariantId, name])
}

// ===========================================================================
// Wheel catalog
// ===========================================================================

model WheelBrand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models WheelModel[]

  @@unique([tenantId, name])
}

model WheelModel {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  wheelBrandId String    @db.Uuid
  name         String
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand          WheelBrand           @relation(fields: [wheelBrandId], references: [id], onDelete: Cascade)
  finishes       WheelFinish[]
  sizes          WheelSize[]
  configurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([wheelBrandId])
  @@unique([tenantId, wheelBrandId, name])
}

model WheelFinish {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  wheelModelId String    @db.Uuid
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  WheelModel @relation(fields: [wheelModelId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
  @@index([wheelModelId])
  @@unique([tenantId, wheelModelId, name])
}

model WheelSize {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  wheelModelId   String    @db.Uuid
  size           String
  diameterInches Int?
  widthInches    Float?
  boltPattern    String?
  offsetMm       Int?
  centreBoreMm   Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  WheelModel @relation(fields: [wheelModelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, size])
  @@index([wheelModelId])
}

// ===========================================================================
// Tyre catalog
// ===========================================================================

model TyreBrand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models TyreModel[]

  @@unique([tenantId, name])
}

model TyreModel {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tyreBrandId String    @db.Uuid
  name        String
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand          TyreBrand            @relation(fields: [tyreBrandId], references: [id], onDelete: Cascade)
  profiles       TyreProfile[]
  configurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([tyreBrandId])
  @@unique([tenantId, tyreBrandId, name])
}

model TyreProfile {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  tyreModelId       String    @db.Uuid
  profile           String
  widthMm           Int?
  aspectRatio       Int?
  rimDiameterInches Int?
  construction      String?
  loadIndex         Int?
  speedRating       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  TyreModel @relation(fields: [tyreModelId], references: [id], onDelete: Cascade)

  @@index([tenantId, profile])
  @@index([tyreModelId])
  @@unique([tenantId, tyreModelId, profile])
}

// ===========================================================================
// Saved configurations & customers
// ===========================================================================

model SavedConfiguration {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  vehicleVariantId String    @db.Uuid
  vehicleModelId   String    @db.Uuid
  wheelModelId     String    @db.Uuid
  tyreModelId      String    @db.Uuid
  name             String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleVariant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)
  vehicleModel   VehicleModel   @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  wheelModel     WheelModel     @relation(fields: [wheelModelId], references: [id], onDelete: Cascade)
  tyreModel      TyreModel      @relation(fields: [tyreModelId], references: [id], onDelete: Cascade)
  quotes         Quote[]

  @@unique([tenantId, name])
  @@index([vehicleVariantId])
  @@index([vehicleModelId])
  @@index([wheelModelId])
  @@index([tyreModelId])
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@index([tenantId, name])
  @@index([email])
  @@unique([tenantId, email])
}

// ===========================================================================
// Quotes (Sprint 8–9)
// ===========================================================================

model Quote {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  customerId           String    @db.Uuid
  savedConfigurationId String    @db.Uuid
  status               String
  totalAmount          Decimal   @db.Decimal(10, 2)
  quoteNumber          String?
  consultantName       String?
  currency             String    @default("ZAR")
  subtotalCents        Int?
  discountCents        Int?
  vatBasisPoints       Int?
  vatCents             Int?
  validUntil           DateTime?
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  savedConfiguration SavedConfiguration  @relation(fields: [savedConfigurationId], references: [id], onDelete: Cascade)
  assets             Asset[]
  lines              QuoteLine[]
  snapshot           QuoteSnapshot?
  statusHistories    QuoteStatusHistory[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([savedConfigurationId])
}

model QuoteLine {
  id              String    @id @default(uuid()) @db.Uuid
  quoteId         String    @db.Uuid
  category        String
  description     String
  quantity        Int
  unitAmountCents Int
  totalCents      Int
  sortOrder       Int       @default(0)
  metadata        Json?
  createdAt       DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  quoteId   String   @unique @db.Uuid
  version   Int      @default(1)
  payload   Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ===========================================================================
// Quote status history (Sprint 9 — lifecycle audit trail)
// ===========================================================================

model QuoteStatusHistory {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  quoteId    String    @db.Uuid
  fromStatus String?
  toStatus   String
  actorName  String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
}

// ===========================================================================
// Assets
// ===========================================================================

model Asset {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  quoteId   String?   @db.Uuid
  fileName  String
  mimeType  String
  url       String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([tenantId, fileName])
  @@index([quoteId])
}

// ===========================================================================
// Audit log
// ===========================================================================

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  entityType String
  entityId   String    @db.Uuid
  action     String
  actorId    String?   @db.Uuid
  details    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType])
  @@index([entityId])
}

// ===========================================================================
// Pricing (Sprint 8)
// ===========================================================================

model PriceList {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  kind      String    @default("RETAIL")
  currency  String    @default("ZAR")
  isDefault Boolean   @default(false)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wheelPrices  WheelPrice[]
  tyrePrices   TyrePrice[]
  labourPrices LabourPrice[]
  priceRules   PriceRule[]

  @@unique([tenantId, name])
}

model PriceRule {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  priceListId        String    @db.Uuid
  category           String
  adjustmentType     String
  percentBasisPoints Int?
  amountCents        Int?
  brand              String?
  priority           Int       @default(0)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId, active])
}

model WheelPrice {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  priceListId  String    @db.Uuid
  wheelModelId String    @db.Uuid
  wheelSizeId  String?
  amountCents  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId, wheelModelId])
}

model TyrePrice {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  priceListId   String    @db.Uuid
  tyreModelId   String    @db.Uuid
  tyreProfileId String?
  amountCents   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId, tyreModelId])
}

model LabourPrice {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  priceListId String    @db.Uuid
  serviceType String
  unit        String
  amountCents Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, serviceType, unit])
}

// ===========================================================================
// Discounts & promotions (Sprint 8, extended Sprint 10)
// ===========================================================================

model DiscountRule {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  name               String
  kind               String
  percentBasisPoints Int?
  amountCents        Int?
  category           String?
  priority           Int       @default(0)
  active             Boolean   @default(true)
  validFrom          DateTime?
  validTo            DateTime?
  restrictions       Json?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// ===========================================================================
// Tenant/dealership settings (Sprint 10)
// ===========================================================================

model TenantSettings {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @unique @db.Uuid
  dealerName           String?
  address              String?
  telephone            String?
  email                String?
  website              String?
  vatNumber            String?
  companyRegistration  String?
  logoUrl              String?
  quoteValidityDays    Int       @default(30)
  currency             String    @default("ZAR")
  timezone             String    @default("Africa/Johannesburg")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// Vehicle packages — admin publishing workflow (Sprint 11)
// ===========================================================================

model VehiclePackage {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  name             String
  manufacturer     String
  model            String
  generation       String?
  year             Int?
  trim             String?
  status           String    @default("DRAFT")
  version          Int       @default(1)
  publishedFlag    Boolean   @default(false)
  colours          Json
  wheelPositions   Json
  wheelMetadata    Json?
  tyreMetadata     Json?
  renderMetadata   Json?
  assetReferences  Json
  validationState  Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}
