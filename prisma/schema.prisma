generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users               User[]
  roles               Role[]
  stores              Store[]
  manufacturers       VehicleManufacturer[]
  models              VehicleModel[]
  variants            VehicleVariant[]
  colours             VehicleColour[]
  wheelBrands         WheelBrand[]
  wheelModels         WheelModel[]
  wheelFinishes       WheelFinish[]
  wheelSizes          WheelSize[]
  tyreBrands          TyreBrand[]
  tyreModels          TyreModel[]
  tyreProfiles        TyreProfile[]
  savedConfigurations SavedConfiguration[]
  customers           Customer[]
  quotes              Quote[]
  assets              Asset[]
  auditLogs           AuditLog[]
  quoteSequence       Int                 @default(0)
  priceLists          PriceList[]
  wheelPrices         WheelPrice[]
  tyrePrices          TyrePrice[]
  labourPrices        LabourPrice[]
  priceRules          PriceRule[]
  discountRules       DiscountRule[]
  quoteSnapshots      QuoteSnapshot[]

  @@index([slug])
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  email     String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@index([tenantId])
  @@index([email])
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@index([tenantId, name])
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Store {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
}

model VehicleManufacturer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models VehicleModel[]

  @@unique([tenantId, name])
}

model VehicleModel {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  vehicleManufacturerId String    @db.Uuid
  name                  String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manufacturer        VehicleManufacturer  @relation(fields: [vehicleManufacturerId], references: [id], onDelete: Cascade)
  variants            VehicleVariant[]
  savedConfigurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([vehicleManufacturerId])
  @@unique([tenantId, vehicleManufacturerId, name])
}

model VehicleVariant {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  vehicleModelId  String    @db.Uuid
  name            String
  year            Int?
  wheelDiameterMm Int
  renderMetadata  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model          VehicleModel         @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  colours        VehicleColour[]
  configurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([vehicleModelId])
  @@unique([tenantId, vehicleModelId, name])
}

model VehicleColour {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  vehicleVariantId String    @db.Uuid
  name             String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
  @@index([vehicleVariantId])
  @@unique([tenantId, vehicleVariantId, name])
}

model WheelBrand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models WheelModel[]

  @@unique([tenantId, name])
}

model WheelModel {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  wheelBrandId String    @db.Uuid
  name         String
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand          WheelBrand           @relation(fields: [wheelBrandId], references: [id], onDelete: Cascade)
  finishes       WheelFinish[]
  sizes          WheelSize[]
  configurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([wheelBrandId])
  @@unique([tenantId, wheelBrandId, name])
}

model WheelFinish {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  wheelModelId String    @db.Uuid
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  WheelModel @relation(fields: [wheelModelId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
  @@index([wheelModelId])
  @@unique([tenantId, wheelModelId, name])
}

model WheelSize {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  wheelModelId   String    @db.Uuid
  size           String
  diameterInches Int?
  widthInches    Float?
  boltPattern    String?
  offsetMm       Int?
  centreBoreMm   Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  WheelModel @relation(fields: [wheelModelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, size])
  @@index([wheelModelId])
}

model TyreBrand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models TyreModel[]

  @@unique([tenantId, name])
}

model TyreModel {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tyreBrandId String    @db.Uuid
  name        String
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand          TyreBrand            @relation(fields: [tyreBrandId], references: [id], onDelete: Cascade)
  profiles       TyreProfile[]
  configurations SavedConfiguration[]

  @@index([tenantId, name])
  @@index([tyreBrandId])
  @@unique([tenantId, tyreBrandId, name])
}

model TyreProfile {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  tyreModelId       String    @db.Uuid
  profile           String
  widthMm           Int?
  aspectRatio       Int?
  rimDiameterInches Int?
  construction      String?
  loadIndex         Int?
  speedRating       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  TyreModel @relation(fields: [tyreModelId], references: [id], onDelete: Cascade)

  @@index([tenantId, profile])
  @@index([tyreModelId])
  @@unique([tenantId, tyreModelId, profile])
}

model SavedConfiguration {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  vehicleVariantId String    @db.Uuid
  vehicleModelId   String    @db.Uuid
  wheelModelId     String    @db.Uuid
  tyreModelId      String    @db.Uuid
  name             String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleVariant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)
  vehicleModel   VehicleModel   @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  wheelModel     WheelModel     @relation(fields: [wheelModelId], references: [id], onDelete: Cascade)
  tyreModel      TyreModel      @relation(fields: [tyreModelId], references: [id], onDelete: Cascade)
  quotes         Quote[]

  @@unique([tenantId, name])
  @@index([vehicleVariantId])
  @@index([vehicleModelId])
  @@index([wheelModelId])
  @@index([tyreModelId])
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@index([tenantId, name])
  @@index([email])
  @@unique([tenantId, email])
}

model Quote {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  customerId           String    @db.Uuid
  savedConfigurationId String    @db.Uuid
  status               String
  totalAmount          Decimal   @db.Decimal(10, 2)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  quoteNumber   String?
  consultantName String?
  currency      String   @default("ZAR")
  subtotalCents Int?
  discountCents Int?
  vatBasisPoints Int?
  vatCents      Int?
  validUntil    DateTime?
  archivedAt    DateTime?

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  savedConfiguration SavedConfiguration @relation(fields: [savedConfigurationId], references: [id], onDelete: Cascade)
  assets             Asset[]
  lines              QuoteLine[]
  snapshot           QuoteSnapshot?

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([savedConfigurationId])
}

model Asset {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  quoteId   String?   @db.Uuid
  fileName  String
  mimeType  String
  url       String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([tenantId, fileName])
  @@index([quoteId])
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  entityType String
  entityId   String    @db.Uuid
  action     String
  actorId    String?   @db.Uuid
  details    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType])
  @@index([entityId])
}


// ---------------------------------------------------------------------------
// Sprint 8 — Quote domain (additive; see migration 20260731150000_quote_domain)
// ---------------------------------------------------------------------------

model PriceList {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  kind      String    @default("RETAIL")
  currency  String    @default("ZAR")
  isDefault Boolean   @default(false)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wheelPrices  WheelPrice[]
  tyrePrices   TyrePrice[]
  labourPrices LabourPrice[]
  priceRules   PriceRule[]

  @@unique([tenantId, name])
}

model PriceRule {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  priceListId        String    @db.Uuid
  category           String
  adjustmentType     String
  percentBasisPoints Int?
  amountCents        Int?
  brand              String?
  priority           Int       @default(0)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId, active])
}

model WheelPrice {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  priceListId  String    @db.Uuid
  wheelModelId String    @db.Uuid
  wheelSizeId  String?
  amountCents  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId, wheelModelId])
}

model TyrePrice {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  priceListId   String    @db.Uuid
  tyreModelId   String    @db.Uuid
  tyreProfileId String?
  amountCents   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId, tyreModelId])
}

model LabourPrice {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  priceListId String    @db.Uuid
  serviceType String
  unit        String
  amountCents Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, serviceType, unit])
}

model DiscountRule {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  name               String
  kind               String
  percentBasisPoints Int?
  amountCents        Int?
  category           String?
  priority           Int       @default(0)
  active             Boolean   @default(true)
  validFrom          DateTime?
  validTo            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

model QuoteLine {
  id              String   @id @default(uuid()) @db.Uuid
  quoteId         String   @db.Uuid
  category        String
  description     String
  quantity        Int
  unitAmountCents Int
  totalCents      Int
  sortOrder       Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  quoteId   String   @unique @db.Uuid
  version   Int      @default(1)
  payload   Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
