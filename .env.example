# WheelVision environment configuration
#
# Copy this file to .env.local and adjust values for your machine:
#   cp .env.example .env.local
#
# Every variable is validated at startup by the single authoritative
# Zod schema in config/env.ts. Do not commit real environment files —
# .env, .env.* and .env.local are git-ignored; only this template is tracked.

# --- Required ---

# PostgreSQL connection string used by Prisma (runtime, migrations and seed).
# Local default matches a stock PostgreSQL install: postgres:postgres@localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheelvision

# --- Optional (defaults shown) ---

# Node environment. next dev / next build / vitest set this automatically;
# only set it explicitly for custom tooling. One of: development | test | production
NODE_ENV=development

# Public base URL of the application (used for absolute links and metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Show the React Query Devtools panel. Any value other than "true" is disabled.
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false

# Tenant used when a request does not specify one via the x-tenant-slug
# header. Matches the tenant created by `npm run db:seed` for local dev.
DEFAULT_TENANT_SLUG=demo-tenant
